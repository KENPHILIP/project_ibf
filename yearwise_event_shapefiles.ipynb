   "source": [
    "import geopandas as gpd\n",
    "import pandas as pd\n",
    "from ast import literal_eval\n",
    "import os\n",
    "import shapely\n",
    "from shapely.geometry import Polygon, MultiPolygon\n",
    "\n",
    "def create_yearly_shapefiles(event_adm2_file, event_type, adm2_file, output_dir):\n",
    "    \"\"\"\n",
    "    Create yearly shapefiles ensuring QGIS compatibility\n",
    "    \"\"\"\n",
    "    # Create output directory if it doesn't exist\n",
    "    os.makedirs(output_dir, exist_ok=True)\n",
    "    \n",
    "    # Read the event-specific ADM2 mapping\n",
    "    dfb_event_adm2 = pd.read_excel(event_adm2_file, engine='openpyxl')\n",
    "    dfb_event_adm2['adm2_list'] = dfb_event_adm2.geob_adm2_list.apply(lambda x: literal_eval(str(x)))\n",
    "    \n",
    "    # Extract year from Dis No\n",
    "    dfb_event_adm2['year'] = dfb_event_adm2['Dis No'].str[:4].astype(int)\n",
    "    \n",
    "    # Read ADM2 boundaries\n",
    "    adm2 = gpd.read_file(adm2_file)\n",
    "    \n",
    "    # Ensure proper CRS\n",
    "    if not adm2.crs:\n",
    "        adm2.set_crs(epsg=4326, inplace=True)\n",
    "    \n",
    "    # Group by year\n",
    "    for year in dfb_event_adm2['year'].unique():\n",
    "        # Get disaster numbers for this year\n",
    "        year_events = dfb_event_adm2[dfb_event_adm2['year'] == year]\n",
    "        \n",
    "        # Get all ADM2 areas affected in this year\n",
    "        adm2_list = []\n",
    "        for event_areas in year_events['adm2_list']:\n",
    "            adm2_list.extend(event_areas)\n",
    "        \n",
    "        # Remove duplicates\n",
    "        adm2_list = list(set(adm2_list))\n",
    "        \n",
    "        # Create GeoDataFrame for this year\n",
    "        year_gdf = adm2[adm2['shapeID'].isin(adm2_list)].copy()\n",
    "        \n",
    "        # Add event information\n",
    "        year_gdf['event_year'] = year\n",
    "        year_gdf['event_type'] = event_type\n",
    "        year_gdf['event_count'] = 1\n",
    "        \n",
    "        # Ensure valid geometries\n",
    "        year_gdf['geometry'] = year_gdf['geometry'].apply(lambda x: x if x.is_valid else x.buffer(0))\n",
    "        \n",
    "        # Add essential columns if not present\n",
    "        if 'id' not in year_gdf.columns:\n",
    "            year_gdf['id'] = range(len(year_gdf))\n",
    "            \n",
    "        # Select and order columns\n",
    "        year_gdf = year_gdf[['id', 'shapeID', 'event_year', 'event_type', 'event_count', 'geometry']]\n",
    "        \n",
    "        # Ensure proper CRS is set\n",
    "        year_gdf.set_crs(adm2.crs, inplace=True)\n",
    "        \n",
    "        if not year_gdf.empty:\n",
    "            # Save to shapefile\n",
    "            output_file = os.path.join(output_dir, f'{event_type.lower()}_{year}.shp')\n",
    "            year_gdf.to_file(output_file, driver='ESRI Shapefile')\n",
    "            print(f\"Created shapefile for {event_type} events in {year}\")\n",
    "        else:\n",
    "            print(f\"No events found for {event_type} in {year}\")\n",
    "\n",
    "def validate_shapefile(shapefile_path):\n",
    "    \"\"\"\n",
    "    Validate if shapefile is readable and has valid geometries\n",
    "    \"\"\"\n",
    "    try:\n",
    "        gdf = gpd.read_file(shapefile_path)\n",
    "        print(f\"Successfully read {shapefile_path}\")\n",
    "        print(f\"Number of features: {len(gdf)}\")\n",
    "        print(f\"CRS: {gdf.crs}\")\n",
    "        print(f\"Columns: {gdf.columns.tolist()}\")\n",
    "        print(f\"All geometries valid: {all(gdf.geometry.is_valid)}\")\n",
    "        return True\n",
    "    except Exception as e:\n",
    "        print(f\"Error reading {shapefile_path}: {str(e)}\")\n",
    "        return False\n",
    "\n",
    
    "if __name__ == \"__main__\":\n",
    "    
    "    flood_adm2_file = 'data/em_dat_ea_flood_adm2_v0.xlsx'\n",
    "    drought_adm2_file = 'em_dat_ea_drought_adm2_v2.xlsx'\n",
    "    adm2_file = 'ea_adm2_geoboundaries.shp'\n",
    "    \n",
    "    
    "    flood_output_dir = 'output/yearly_flood_shp'\n",
    "    drought_output_dir = 'output/yearly_drought_shp'\n",
    "    \n",
    "   
    "    print(\"Creating flood shapefiles...\")\n",
    "    create_yearly_shapefiles(\n",
    "        event_adm2_file=flood_adm2_file,\n",
    "        event_type='Flood',\n",
    "        adm2_file=adm2_file,\n",
    "        output_dir=flood_output_dir\n",
    "    )\n",
    "    \n",
    "    print(\"\\nCreating drought shapefiles...\")\n",
    "    create_yearly_shapefiles(\n",
    "        event_adm2_file=drought_adm2_file,\n",
    "        event_type='Drought',\n",
    "        adm2_file=adm2_file,\n",
    "        output_dir=drought_output_dir\n",
    "    )\n",
    "    \n",
    "    
    "    print(\"\\nValidating created shapefiles...\")\n",
    "    for directory in [flood_output_dir, drought_output_dir]:\n",
    "        if os.path.exists(directory):\n",
    "            for filename in os.listdir(directory):\n",
    "                if filename.endswith('.shp'):\n",
    "                    filepath = os.path.join(directory, filename)\n",
    "                    print(f\"\\nValidating {filename}:\")\n",
    "                    validate_shapefile(filepath)"
   ]
